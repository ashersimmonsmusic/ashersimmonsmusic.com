# Sanity — content management. Leave unset to fall back to the placeholder
# content in lib/data/* during development.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Supabase — Postgres, Auth, Storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — commerce (not yet wired to checkout).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — transactional email & newsletter.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Asher Simmons Music <hello@ashersimmonsmusic.com>"
CONTACT_INBOX_EMAIL=ashersimmonsmusic@gmail.com
# Signs newsletter unsubscribe links. Must match the same variable in the
# agent that sends the newsletter, or its links won't verify here.
# Generate with: openssl rand -hex 32
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Plausible — analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ashersimmonsmusic.com

# Printify — powers the product preview widget on /store. Leave unset to
# hide the widget (the page still links out to siteConfig.printifyStoreUrl).
# Get the token from Printify: My Profile > Connections > create a token.
# Get the shop ID from GET https://api.printify.com/v1/shops.json with that token.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Optional, defaults to GBP. ISO 4217 code matching your Printify shop's currency.
PRINTIFY_CURRENCY=GBP
